### 4.3 Application Model

**Responsabilité :** agréger les observations et la FSM en un **graphe comportemental structuré** qui représente l'application telle qu'elle se comporte — pas telle qu'elle est documentée.

**Structure du graphe :**

```typescript
interface ApplicationModel {
  endpoints: EndpointNode[];
  parameters: ParameterNode[];
  objects: DataObjectNode[];
  roles: RoleNode[];
  relations: Relation[];
  fsm: ApplicationFSM;
  technologies: TechStack;
  last_updated: string;
}

interface EndpointNode {
  id: string;
  path: string;
  methods: HttpMethod[];
  auth_required: boolean;
  roles_observed: string[];
  parameters: string[];           // IDs des ParameterNode associés
  returns: string[];              // IDs des DataObjectNode observés
}

interface ParameterNode {
  id: string;
  name: string;
  location: "query" | "body" | "header" | "path" | "cookie";
  type_inferred: "integer" | "string" | "uuid" | "boolean" | "object" | "array";
  affects_object?: string;        // ID du DataObjectNode contrôlé
  is_user_controlled: boolean;
}

interface DataObjectNode {
  id: string;
  schema: Record<string, string>; // champ → type inféré
  owner_parameter?: string;       // paramètre qui détermine l'ownership
  sensitivity: "public" | "private" | "sensitive";
}

interface RoleNode {
  id: string;
  name: string;
  observed_permissions: string[]; // endpoints accessibles observés
}
```

